# Runs under bash or zsh.  Paths are found from the location of this script.
#
# Prints the music folder (the root) that the library database records:
#     scripts/show-music-root-directory
# The database is the one given with --database, else the one given to
# scripts/setup.  The root is printed alone on standard output; the database
# is not changed.  See desktop/show_music_root_directory.py.
set -o errexit
set -o nounset
set -o pipefail
here=$(cd "$(dirname "${0}")" && pwd)
root=$(dirname "${here}")
tools_dir="${root}/android/tools"
# no .pyc files, also in anything Python starts
export PYTHONDONTWRITEBYTECODE=1
# the shared modules
export PYTHONPATH="${root}/desktop:${tools_dir}${PYTHONPATH:+:${PYTHONPATH}}"
. "${here}/require-venv"
music_require_venv


# The database is the one given with --database, else MILKCRATEVINYL_DATABASE.
program="${root}/desktop/show_music_root_directory.py"
if music_option_given --database -d "${@}"; then
    "${MILKCRATEVINYL_VENV}/bin/python" -B "${program}" "${@}"
else
    music_require_database --database
    "${MILKCRATEVINYL_VENV}/bin/python" -B "${program}" \
        --database "${MILKCRATEVINYL_DATABASE}" "${@}"
fi
