# SPDX-License-Identifier: GPL-3.0-only
# This program is free software: you can redistribute it and/or modify it
# under the terms of the GNU General Public License version 3 as published
# by the Free Software Foundation.  It is distributed WITHOUT ANY WARRANTY;
# see the file LICENSE for the license text.
#
# Runs under bash or zsh.  Paths are found from the location of this script.
#
# Packages the desktop programs, the Windows scripts and the phone's APK as a
# zip file that is unzipped and used on Windows:
#
#     scripts/package-for-windows [--no-build]
#
# The APK is built first with scripts/build-for-android, unless --no-build is
# given (the APK already in the BOD is used).  The archive is
# ${MILKCRATEVINYL_BOD}/milkcrate-vinyl-VERSION-windows.zip, where VERSION is
# the output of git describe.  Its top folder holds 00-READ-ME-FIRST.txt (the
# Windows README, named so that it sorts before everything else), the APK,
# scripts/ with the .bat files, desktop/, android/tools/, docs/, LICENSE and
# README.md.  The .bat, .txt and .md files are given Windows line ends; the
# Python files keep theirs.
set -o errexit
set -o nounset
set -o pipefail
here=$(cd "$(dirname "${0}")" && pwd)
root=$(dirname "${here}")
. "${here}/require-venv"
music_require_bod

build=1
case "${1:-}" in
    "") ;;
    --no-build) build=0 ;;
    *) echo "usage: package-for-windows [--no-build]" >&2; exit 2 ;;
esac

bod=$(realpath -m -- "${MILKCRATEVINYL_BOD}")
apk="${bod}/milkcrate-vinyl-arm64_v8a.apk"
if [ "${build}" = 1 ]; then
    "${here}/build-for-android" arm64_v8a
fi
if [ ! -f "${apk}" ]; then
    echo "error: ${apk} is missing; run without --no-build" >&2
    exit 1
fi

version=$(cd "${root}" && git describe --always --dirty)
name="milkcrate-vinyl-${version}"
stage=$(mktemp -d "${bod}/package.XXXXXX")
trap 'rm -rf "${stage}"' EXIT
top="${stage}/${name}"
mkdir -p "${top}/scripts" "${top}/desktop" "${top}/android/tools" \
      "${top}/docs"

# a file with Windows line ends: LF becomes CRLF, a CRLF is kept
crlf() {
    sed 's/\r$//; s/$/\r/' "${1}" > "${2}"
}

cp "${apk}" "${top}/"
cp "${root}/LICENSE" "${top}/"
cp "${root}"/desktop/*.py "${root}/desktop/requirements.txt" "${top}/desktop/"
cp "${root}"/android/tools/*.py "${top}/android/tools/"
for f in "${root}"/docs/*.txt; do
    crlf "${f}" "${top}/docs/$(basename "${f}")"
done
crlf "${root}/README.md" "${top}/README.md"
crlf "${root}/windows/README.txt" "${top}/00-READ-ME-FIRST.txt"
for f in "${root}"/windows/*.bat; do
    crlf "${f}" "${top}/scripts/$(basename "${f}")"
done

out="${bod}/${name}-windows.zip"
rm -f "${out}"
(cd "${stage}" && zip -q -r -X "${out}" "${name}")
echo "package: ${out}"
unzip -Z1 "${out}" | wc -l | sed 's/$/ files/'
