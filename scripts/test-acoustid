# Runs under bash or zsh.  Paths are found from the location of this script.
set -o errexit
set -o nounset
set -o pipefail
here=$(cd "$(dirname "${0}")" && pwd)
root=$(dirname "${here}")
tools_dir="${root}/android/tools"
# no .pyc files, also in anything Python starts
export PYTHONDONTWRITEBYTECODE=1
# the shared modules
export PYTHONPATH="${root}/desktop:${tools_dir}${PYTHONPATH:+:${PYTHONPATH}}"
. "${here}/require-venv"
music_require_venv
music_require_env ACOUSTID_API_KEY "your AcoustID application key"
MILKCRATEVINYL_ROOT="${root}" "${MILKCRATEVINYL_VENV}/bin/python" -B - <<'PY'
import os
import acoustid
import musicbrainzngs as mb

mb.set_useragent("file-tags", "0.1", "thutt@harp-project.com")
path = os.path.join(
    os.environ["MILKCRATEVINYL_ROOT"],
    "data/cd-music/acquired/damn.yankees.discography/(1992) Dont Tread",
    "01 - Don't Tread On Me.mp3",
)
key = os.environ["ACOUSTID_API_KEY"]
for score, rec_id, title, artist in acoustid.match(
    key, path, force_fpcalc=True
):
    print(f"{score:.2f}  {artist} - {title}  {rec_id}")
    rec = mb.get_recording_by_id(rec_id, includes=["artists", "releases"])
    releases = rec["recording"].get("release-list", [])
    print([r["title"] + " (" + r.get("date", "?") + ")" for r in releases][:5])
    break
PY
